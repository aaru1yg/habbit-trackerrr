# Public Supabase client config — injected at BUILD TIME by Vite.
# These two values are safe to expose in a frontend bundle: the anon key is
# a public key and all access is constrained by Row Level Security.
#
# NEVER put the service_role key or the database password in this file or in
# any VITE_ variable — anything VITE_ prefixed is compiled into public JS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
